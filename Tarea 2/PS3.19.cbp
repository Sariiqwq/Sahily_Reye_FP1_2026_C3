#include <iostream>
using namespace std;

int main() {
    for (int i = 1; i <= 10; i++) {

        for (int j = 1; j <= 10 - i; j++)
            cout << " ";

        for (int j = i; j <= 2 * i - 1; j++)
            cout << j % 10;

        for (int j = 2 * i - 2; j >= i; j--)
            cout << j % 10;

        cout << endl;
    }

    return 0;
}
